#!/usr/bin/env bash
set -euo pipefail

hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "$hook_dir/lib/common.sh"

[[ $# -eq 1 ]] || hook_reject 'expected the commit-message file argument'
message_file="$1"
subject="$(sed -n '1p' "$message_file")"

hook_log "validating subject=$subject"

if [[ "${HOOK_DEMO_REJECT_WIP:-0}" == 1 && "$subject" == WIP* ]]; then
  hook_reject 'commit subjects beginning with WIP are disabled for this demo'
fi

if [[ -n "${HOOK_DEMO_REQUIRE_PREFIX:-}" && \
      "$subject" != "${HOOK_DEMO_REQUIRE_PREFIX}"* ]]; then
  hook_reject "subject must begin with ${HOOK_DEMO_REQUIRE_PREFIX}"
fi

hook_maybe_reject
