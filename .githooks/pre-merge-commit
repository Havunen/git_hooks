#!/usr/bin/env bash
set -euo pipefail

hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "$hook_dir/lib/common.sh"

merge_head="$(git rev-parse --short -q --verify MERGE_HEAD 2>/dev/null || printf 'unknown')"
hook_log "checking the staged merge result; MERGE_HEAD=$merge_head"
hook_maybe_reject
