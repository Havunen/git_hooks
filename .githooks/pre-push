#!/usr/bin/env bash
set -euo pipefail

hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "$hook_dir/lib/common.sh"

[[ $# -eq 2 ]] || hook_reject 'expected remote name and URL'
remote_name="$1"
remote_url="$2"
update_count=0

while read -r local_ref local_oid remote_ref remote_oid; do
  ((update_count += 1))
  hook_log "update[$update_count] $local_ref@$local_oid -> $remote_ref@$remote_oid"
done

hook_log "checked $update_count update(s) for remote=$remote_name url=$(hook_quote "$remote_url")"
hook_maybe_reject
