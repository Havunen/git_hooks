#!/usr/bin/env bash
set -euo pipefail

hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "$hook_dir/lib/common.sh"

[[ $# -eq 3 ]] || hook_reject 'expected ref name, old object, and new object'
ref_name="$1"
old_oid="$2"
new_oid="$3"

hook_log "validating one ref; $ref_name $old_oid -> $new_oid"
hook_maybe_reject
